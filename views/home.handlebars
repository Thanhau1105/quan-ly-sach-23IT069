<section class="summary" aria-label="Quy tắc dữ liệu">
<div><span>Tiền tố mã sách</span><strong>{{prefix}}</strong></div>
<div><span>Thuế VAT</span><strong>{{vatPercent}}%</strong></div>
<div><span>Database</span><strong>DB_{{studentId}}</strong></div></section>
{{#if error}}<p class="notice error" role="alert">{{error}}</p>{{/if}}
{{#if success}}<p class="notice success" role="status">{{success}}</p>{{/if}}
<div class="workspace"><section class="card">
<h2>Thêm sách mới</h2><p class="hint">Giá sau thuế được tính tự động trước khi lưu.</p>
<form action="/books" method="POST">
<input type="hidden" name="csrfToken" value="{{csrfToken}}">
<label for="code">Mã sách</label><input id="code" name="code" placeholder="{{prefix}}-S001" maxlength="50" required aria-describedby="code-help">
<small id="code-help">Bắt đầu bằng {{prefix}}, ví dụ {{prefix}}-S001.</small>
<label for="title">Tên sách</label><input id="title" name="title" placeholder="Nhập môn điện toán đám mây" maxlength="200" required>
<label for="price">Giá trước thuế (đồng)</label><input id="price" name="price" type="number" min="0" max="1000000000000" step="1" placeholder="100000" required>
<button type="submit">Thêm sách</button></form></section>
<section class="card"><h2>Danh sách sách</h2><p class="hint">Hiển thị tối đa 100 sách mới nhất.</p>
<div class="table-wrap"><table><thead><tr><th scope="col">Mã sách</th><th scope="col">Tên sách</th><th scope="col">Giá gốc</th><th scope="col">VAT</th><th scope="col">Sau thuế</th></tr></thead>
<tbody>{{#each books}}<tr><td><code>{{code}}</code></td><td>{{title}}</td><td class="money">{{priceText}}</td><td>{{vatPercent}}%</td><td class="money"><strong>{{finalPriceText}}</strong></td></tr>
{{else}}<tr><td colspan="5" class="empty">Chưa có sách. Thêm cuốn sách đầu tiên bằng biểu mẫu bên cạnh.</td></tr>{{/each}}</tbody></table></div></section></div>
<details class="session"><summary>Thông tin kiểm tra phiên</summary><p>Mã minh họa: <code>{{demoId}}</code></p><p>Tạo lúc: {{startedAt}}</p><p>Mã này cần giữ nguyên khi tải lại trang hoặc khởi động lại server, trong thời hạn phiên.</p></details>
